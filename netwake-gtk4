#!/usr/bin/env python3
# =======================================================================
# Titel:  Netwake-GTK4 (GTK4 Port)
# Version: 2.2
# =======================================================================
import gi
import json
import os
import subprocess
import shutil

gi.require_version('Gtk', '4.0')
from gi.repository import Gtk, Gio, GObject, Gdk

CONFIG_FILE = os.path.expanduser("~/.wol_config.json")

# Custom CSS für die blaue (+) und rote (-) Schaltfläche
CSS_DATA = """
button.btn-add {
    color: #1c71d8;
}
button.btn-add image {
    color: #1c71d8;
}

button.btn-remove {
    color: #e01b24;
}
button.btn-remove image {
    color: #e01b24;
}
"""

class ServerObject(GObject.Object):
    """Datenmodell für einen einzelnen Server"""
    __gtype_name__ = 'ServerObject'

    name = GObject.Property(type=str)
    target_type = GObject.Property(type=str) # 'Local' oder 'Internet'
    ip = GObject.Property(type=str)          # Broadcast-Adresse
    mac = GObject.Property(type=str)
    port = GObject.Property(type=int)

    def __init__(self, name, target_type, ip, mac, port):
        super().__init__()
        self.name = name
        self.target_type = target_type
        self.ip = ip
        self.mac = mac
        self.port = port

class AddServerDialog(Gtk.Window):
    """Dialog zum Hinzufügen eines neuen Servers mit Typ-Auswahl"""
    def __init__(self, parent, callback):
        super().__init__(title="Server hinzufügen", transient_for=parent, modal=True)
        self.callback = callback
        self.set_default_size(380, 280)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.set_margin_top(15)
        box.set_margin_bottom(15)
        box.set_margin_start(15)
        box.set_margin_end(15)
        self.set_child(box)

        grid = Gtk.Grid(column_spacing=10, row_spacing=10)
        box.append(grid)

        # 1. Name
        grid.attach(Gtk.Label(label="Name:", xalign=0), 0, 0, 1, 1)
        self.name_entry = Gtk.Entry(placeholder_text="z. B. Home-Server")
        grid.attach(self.name_entry, 1, 0, 1, 1)

        # 2. Ziel-Typ (Lokal / Internet)
        grid.attach(Gtk.Label(label="Ziel-Typ:", xalign=0), 0, 1, 1, 1)
        self.type_combo = Gtk.DropDown.new_from_strings(["Lokal", "Internet"])
        self.type_combo.connect("notify::selected", self.on_type_changed)
        grid.attach(self.type_combo, 1, 1, 1, 1)

        # 3. Broadcast-Adresse
        grid.attach(Gtk.Label(label="Broadcast-Adresse:", xalign=0), 0, 2, 1, 1)
        self.ip_entry = Gtk.Entry(text="255.255.255.255")
        self.ip_entry.set_sensitive(False)  # Standardmäßig bei 'Lokal' gesperrt
        grid.attach(self.ip_entry, 1, 2, 1, 1)

        # 4. MAC-Adresse
        grid.attach(Gtk.Label(label="MAC-Adresse:", xalign=0), 0, 3, 1, 1)
        self.mac_entry = Gtk.Entry(placeholder_text="00:11:22:33:44:55")
        grid.attach(self.mac_entry, 1, 3, 1, 1)

        # 5. Port
        grid.attach(Gtk.Label(label="Port:", xalign=0), 0, 4, 1, 1)
        self.port_entry = Gtk.Entry(text="9")
        grid.attach(self.port_entry, 1, 4, 1, 1)

        # Buttons
        btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        btn_box.set_halign(Gtk.Align.END)
        box.append(btn_box)

        cancel_btn = Gtk.Button(label="Abbrechen")
        cancel_btn.connect("clicked", lambda w: self.destroy())
        btn_box.append(cancel_btn)

        add_btn = Gtk.Button(label="Hinzufügen")
        add_btn.add_css_class("suggested-action")
        add_btn.connect("clicked", self.on_add_clicked)
        btn_box.append(add_btn)

    def on_type_changed(self, dropdown, param):
        """Aktiviert/Deaktiviert das Broadcast-Eingabefeld je nach Auswahl"""
        is_internet = (dropdown.get_selected() == 1) # 0 = Lokal, 1 = Internet
        self.ip_entry.set_sensitive(is_internet)
        if not is_internet:
            self.ip_entry.set_text("255.255.255.255")

    def on_add_clicked(self, button):
        name = self.name_entry.get_text().strip()
        is_internet = (self.type_combo.get_selected() == 1)
        target_type = "Internet" if is_internet else "Lokal"

        ip = self.ip_entry.get_text().strip() if is_internet else "255.255.255.255"
        mac = self.mac_entry.get_text().strip()

        try:
            port = int(self.port_entry.get_text().strip())
        except ValueError:
            port = 9

        if name and mac:
            self.callback(name, target_type, ip, mac, port)
            self.destroy()

class WoLApp(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Netwake GTK4")
        self.set_default_size(700, 250)

        self.apply_css()
        self.check_dependencies()

        # Daten-Model initialisieren
        self.model = Gio.ListStore(item_type=ServerObject)
        self.load_config()

        # Layout-Hauptbox
        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.set_child(main_box)

        # --- OBERER BEREICH: HeaderBar / Steuerung ---
        header = Gtk.HeaderBar()
        self.set_titlebar(header)

        # "Aufwecken" Button
        wake_btn = Gtk.Button(label="Aufwecken")
        wake_btn.add_css_class("suggested-action")
        wake_btn.connect("clicked", self.send_wol)
        header.pack_start(wake_btn)

        # Blaues (+) Icon-Button
        add_btn = Gtk.Button.new_from_icon_name("list-add-symbolic")
        add_btn.add_css_class("btn-add")
        add_btn.set_tooltip_text("Server hinzufügen")
        add_btn.connect("clicked", self.show_add_dialog)
        header.pack_start(add_btn)

        # Rotes (-) Icon-Button
        remove_btn = Gtk.Button.new_from_icon_name("list-remove-symbolic")
        remove_btn.add_css_class("btn-remove")
        remove_btn.set_tooltip_text("Ausgewählten Server löschen")
        remove_btn.connect("clicked", self.remove_selected)
        header.pack_start(remove_btn)

        # Speichern Button
        save_btn = Gtk.Button(label="Speichern")
        save_btn.connect("clicked", self.save_config)
        header.pack_end(save_btn)

        # --- UNTERER BEREICH: Serverliste (GtkColumnView) ---
        self.selection_model = Gtk.SingleSelection.new(self.model)
        self.column_view = Gtk.ColumnView.new(self.selection_model)

        self.setup_columns()

        # ScrolledWindow für die Liste
        scrolled = Gtk.ScrolledWindow()
        scrolled.set_vexpand(True)
        scrolled.set_child(self.column_view)
        main_box.append(scrolled)

    def apply_css(self):
        """Lädt die benutzerdefinierte CSS-Formatierung für die Icons"""
        css_provider = Gtk.CssProvider()
        css_provider.load_from_data(CSS_DATA.encode('utf-8'))
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(),
            css_provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    def setup_columns(self):
        """Erstellt die Tabellenspalten für Name, Typ, Broadcast-Adresse, MAC und Port"""
        fields = [
            ("Server-Name", "name"),
            ("Typ", "target_type"),
            ("Broadcast-Adresse", "ip"),
            ("MAC-Adresse", "mac"),
            ("Port", "port")
        ]

        for title, prop in fields:
            factory = Gtk.SignalListItemFactory()
            factory.connect("setup", self._on_factory_setup)
            factory.connect("bind", self._on_factory_bind, prop)

            column = Gtk.ColumnViewColumn.new(title, factory)
            column.set_expand(True)
            self.column_view.append_column(column)

    def _on_factory_setup(self, factory, list_item):
        label = Gtk.Label(xalign=0)
        label.set_margin_start(5)
        label.set_margin_end(5)
        list_item.set_child(label)

    def _on_factory_bind(self, factory, list_item, prop):
        server = list_item.get_item()
        label = list_item.get_child()
        label.set_text(str(getattr(server, prop)))

    def check_dependencies(self):
        """Überprüft, ob netcat installiert ist, und zeigt ggf. einen Dialog an."""
        if shutil.which("nc") is None:
            dialog = Gtk.AlertDialog(
                message="Netcat (nc) nicht gefunden!",
                detail=(
                    "Das Tool 'netcat' ist für dieses Skript erforderlich.\n\n"
                    "Bitte installiere es mit:\n"
                    "sudo apt update && sudo apt install netcat-openbsd"
                )
            )
            # Zeigt den Dialog asymptotisch an
            dialog.show(self)

    def load_config(self):
        if os.path.exists(CONFIG_FILE):
            try:
                with open(CONFIG_FILE, 'r') as f:
                    data = json.load(f)
                    for item in data:
                        server = ServerObject(
                            item.get('name', 'Unbenannt'),
                            item.get('target_type', 'Lokal'),
                            item.get('ip', '255.255.255.255'),
                            item.get('mac', ''),
                            item.get('port', 9)
                        )
                        self.model.append(server)
            except Exception as e:
                print(f"Fehler beim Laden der Konfiguration: {e}")

    def save_config(self, widget=None):
        data = []
        for i in range(self.model.get_n_items()):
            srv = self.model.get_item(i)
            data.append({
                'name': srv.name,
                'target_type': srv.target_type,
                'ip': srv.ip,
                'mac': srv.mac,
                'port': srv.port
            })
        with open(CONFIG_FILE, 'w') as f:
            json.dump(data, f, indent=4)
        print("Konfiguration gespeichert.")

    def show_add_dialog(self, widget):
        dialog = AddServerDialog(self, self.add_server_callback)
        dialog.present()

    def add_server_callback(self, name, target_type, ip, mac, port):
        server = ServerObject(name, target_type, ip, mac, port)
        self.model.append(server)
        self.save_config()

    def remove_selected(self, widget):
        selected_index = self.selection_model.get_selected()
        if selected_index != Gtk.INVALID_LIST_POSITION:
            self.model.remove(selected_index)
            self.save_config()

    def send_wol(self, widget):
        selected_item = self.selection_model.get_selected_item()
        if not selected_item:
            print("Kein Server ausgewählt.")
            return

        mac_clean = selected_item.mac.replace(":", "").replace("-", "")
        ip = selected_item.ip or "255.255.255.255"
        port = selected_item.port or 9

        # Bash-Netcat Befehl
        bash_command = (
            f"echo -e $(echo $(printf 'f%.0s' {{1..12}}; "
            f"printf '{mac_clean}%.0s' {{1..16}}) | sed -e 's/../\\\\x&/g') | "
            f"nc -w1 -u -b {ip} {port}"
        )

        try:
            subprocess.run(bash_command, shell=True, check=True, executable='/bin/bash')
            print(f"WOL-Paket ({selected_item.target_type}) an {selected_item.name} ({selected_item.mac}) via {ip}:{port} gesendet.")
        except subprocess.CalledProcessError as e:
            print(f"Fehler beim Senden: {e}")

class Application(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.example.wolmanager")

    def do_activate(self):
        win = self.props.active_window
        if not win:
            win = WoLApp(self)
        win.present()

if __name__ == "__main__":
    app = Application()
    app.run(None)
